/*
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  X-XSS-Protection: 1; mode=block
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://embed.cloudflarestream.com; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://formsubmit.co https://*.cloudflarestream.com; frame-src 'self' https://*.cloudflarestream.com https://www.youtube.com https://player.twitch.tv; form-action 'self' https://formsubmit.co; frame-ancestors 'none'; base-uri 'self'

/live-prints.html
  Cache-Control: no-store

/shop.html
  Cache-Control: no-store

/live-prints.js
  Cache-Control: no-store

/shop.js
  Cache-Control: no-store

/data/current-print.json
  Cache-Control: no-store

/data/live-products.json
  Cache-Control: no-store

/print-assets/current-print.png
  Cache-Control: no-store
